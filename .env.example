# Server-only configuration for the connected conversation page and API.
# No runtime model selected; T09 evaluates account-available candidates.
# Never use NEXT_PUBLIC_ for credentials. Never copy SongRise credentials.
OPENAI_API_KEY=
OPENAI_MODEL=
# Fixtures are test/development only; npm run start rejects them before listening.
# Live adapter requires COACH_PROVIDER=openai.
COACH_PROVIDER=fixtures
APP_ORIGIN=http://127.0.0.1:3000
# Optional only behind a gateway that strips/overwrites this header with a validated key.
# Blank means one shared local instance bucket; do not trust arbitrary forwarded headers.
COACH_CLIENT_KEY_HEADER=
