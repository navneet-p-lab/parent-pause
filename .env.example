# Reserved for the server-only provider/configuration packets T05/T06.
# Bootstrap does not read these values, expose an endpoint or call a provider.
# Never use NEXT_PUBLIC_ for credentials. Never copy SongRise credentials.
OPENAI_API_KEY=
OPENAI_MODEL=
# Production must reject fixture mode; T06 implements this validation.
COACH_PROVIDER=fixtures
APP_ORIGIN=http://127.0.0.1:3000
